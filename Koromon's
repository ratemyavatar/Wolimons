.catalog-link-button-icon { width: 1.6em; height: 1.6em; flex: 0 0 auto; color: rgb(238, 238, 238); }

.catalog-link-button-icon svg { display: block; width: 100%; height: 100%; }

.gen_items_slider_outer_container { --gen-items-slider-img-size: 110px; position: relative; }

.koro_slider { overflow: auto hidden; scroll-behavior: smooth; scrollbar-width: none; }

.koro_slider::-webkit-scrollbar { display: none; }

.koro_slider_track { display: flex; gap: 10px; }

.gen_items_slider_card { flex: 0 0 auto; width: calc(var(--gen-items-slider-img-size) + 22px); }

.gen_items_slider_card a:hover { text-decoration: none; }

.gen_items_slider_card_container { background-color: rgb(48, 54, 60); margin: 3px 0px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; border-radius: 7px; }

.gen_items_slider_main_image_container { position: relative; height: var(--gen-items-slider-img-size); background-image: linear-gradient(rgb(58, 63, 68), rgb(73, 78, 81) 50%, rgb(58, 63, 68)); }

.gen_items_slider_card_main_image { display: block; margin-left: auto; margin-right: auto; width: var(--gen-items-slider-img-size); height: var(--gen-items-slider-img-size); aspect-ratio: 1 / 1; object-fit: contain; }

.gen_items_slider_info_section { margin: 0.15em 0.45em 0.2em; }

.gen_items_slider_title_container { margin: 0.2em 0.45em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.gen_items_slider_title { font-weight: 500; color: rgb(220, 223, 226); font-size: 0.9em; }

.gen_items_slider_stat_row { display: flex; justify-content: space-between; }

.gen_items_slider_stat_header { color: rgb(122, 130, 136); font-size: 0.75em; }

.gen_items_slider_stat_data { color: rgb(188, 194, 199); font-size: 0.75em; margin-left: 0.35em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

@media (min-width: 576px) {
  .gen_items_slider_title { font-size: 0.95em; }
  .gen_items_slider_stat_header { font-size: 0.82em; }
  .gen_items_slider_stat_data { font-size: 0.82em; }
}

@media (min-width: 992px) {
  .gen_items_slider_title { font-size: 1em; }
  .gen_items_slider_stat_header { font-size: 0.85em; }
  .gen_items_slider_stat_data { font-size: 0.85em; }
}

.koro_slider_arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border-radius: 50%; border: none; background-color: rgb(0, 132, 221); color: rgb(255, 255, 255); cursor: pointer; z-index: 2; display: flex; align-items: center; justify-content: center; box-shadow: rgba(0, 0, 0, 0.35) 0px 2px 6px; padding: 0px; outline: none; }

.koro_slider_arrow:hover { background-color: rgb(10, 149, 245); }

.koro_slider_arrow svg { width: 18px; height: 18px; display: block; }

.koro_slider_arrow_prev { left: -12px; }

.koro_slider_arrow_next { right: -12px; }

.koro_slider_arrow.d-none { display: none; }

.feature_container { width: 20%; padding: 16px 0px 0px 16px; }

@media (max-width: 489px) {
  .feature_container { width: 100%; margin-right: 16px; }
}

@media (min-width: 490px) {
  .feature_container { width: calc(50% - 8px); }
}

@media (min-width: 768px) {
  .feature_container { width: calc(33.3333% - 5.33333px); }
}

@media (min-width: 992px) {
  .feature_container { width: calc(25% - 4px); }
}

.community-card-title { color: rgb(26, 163, 227); font-size: 1.17188rem; font-weight: 500; }

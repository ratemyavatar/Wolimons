# Wolimons server settings.
#
# Copy this file to ".env" in this same folder and fill in the real values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / Termux)
#
# ".env" is in .gitignore and is never committed. This example file IS
# committed, so never put a real password or token in it.


# ---------------------------------------------------------------------------
# The admin password.
# ---------------------------------------------------------------------------
# This is what you type into the admin panel's sign-in box. It is checked on
# the server, so it is never in any page the visitor downloads.
#
# If it is left empty the admin panel replies "server has no admin key
# configured" and nobody can sign in - which is the safe default.
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Serve the website itself, not just the API.
# ---------------------------------------------------------------------------
# 1 = this one process answers both the pages and the API on one port. That
#     is what you want when self-hosting: one address, no CORS setup.
# 0 = API only (how the Render deployment runs, with the pages on GitHub
#     Pages).
SERVE_STATIC=1

# Port to listen on. 8080 is a good default; 80 makes the address just
# http://your-ip/ but on Linux needs root.
PORT=8080

# Where the site's files are. Defaults to the repo root (the folder above
# this one), which is almost always right. Only set it if you moved things.
# SITE_ROOT=C:\Wolimons

# ---------------------------------------------------------------------------
# Where values and roles are saved.
# ---------------------------------------------------------------------------
# file   = a JSON file on this machine. Use this on your own VPS or PC. No
#          token needed, saves are instant, and the data stays on the server.
#          Kept in proxy/data/wolimons-data.json (gitignored). On the first
#          run it is seeded from the copy committed in the repo, so existing
#          roles and values carry over.
#
# github = commit the data back to the GitHub repo. Only needed on hosts that
#          wipe the disk on restart, like Render's free tier. Requires
#          GITHUB_TOKEN below.
#
# auto   = github if a GITHUB_TOKEN is set, otherwise file. The default.
STORAGE=file

# To back up the file somewhere else, or keep it off the system drive:
# DATA_FILE=D:\WolimonsData\wolimons-data.json

# Only needed when STORAGE=github. Make one at
# https://github.com/settings/tokens - a fine-grained token with
# Contents: read and write on this repository only. It is far more dangerous
# than the admin password, so never commit it.
GITHUB_TOKEN=
GITHUB_REPO=ratemyavatar/Wolimons
GITHUB_BRANCH=main

# ---------------------------------------------------------------------------
# Rarely changed.
# ---------------------------------------------------------------------------
# Where item and player data is fetched from.
# UPSTREAM_ORIGIN=https://wanwoo.xyz

# Comma-separated list of sites allowed to call this API from a browser.
# Unset means any. Only matters if the pages are on a different domain to
# this server; when SERVE_STATIC=1 they are not.
# ALLOWED_ORIGINS=https://ratemyavatar.github.io

# How long an upstream GET is cached, in milliseconds.
# CACHE_TTL_MS=60000

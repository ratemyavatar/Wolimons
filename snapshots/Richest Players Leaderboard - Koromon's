@charset "utf-8";

ul.simple-pagination { list-style: none; }

.simple-pagination { display: block; overflow: hidden; padding: 0px 5px 5px 0px; margin: 0px; }

.simple-pagination ul { list-style: none; padding: 0px; margin: 0px; }

.simple-pagination li { list-style: none; padding: 0px; margin: 0px; float: left; }

span.ellipse.clickable { cursor: pointer; }

.ellipse input { width: 3em; }

.dark-theme span { cursor: pointer; }

.dark-theme a, .dark-theme span { float: left; color: rgb(221, 221, 221); font-size: 14.5px; line-height: 30px; font-weight: normal; text-align: center; border: none; min-width: 33px; padding: 0px 8px; margin: 0px 5px 0px 0px; border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.2) 0px 1px 2px; background: rgb(58, 63, 68); }

.dark-theme a:hover, .dark-theme li:not(.disabled):not(.active) span:hover { text-decoration: none; background: rgb(30, 33, 36); }

.dark-theme .current { background: rgb(34, 34, 34); color: rgb(255, 255, 255); border-color: rgb(0, 0, 0); box-shadow: rgba(255, 255, 255, 0.2) 0px 1px 0px, rgba(0, 0, 0, 0.1) 0px 0px 1px 1px inset; cursor: default; }

.dark-theme .ellipse { background: none; border: none; border-radius: 0px; box-shadow: none; font-weight: bold; cursor: default; }

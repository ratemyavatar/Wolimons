@charset "utf-8";

#page_background { background-image: linear-gradient(rgba(0, 0, 0, 0) 0%, rgb(39, 43, 48)), url("/images/rolimons-banner-blurred.webp"); opacity: 0.75; background-size: cover; background-position: 50% 10%; pointer-events: none; top: 0px; left: 0px; right: 0px; width: 100%; height: 750px; position: fixed; z-index: -1; }

.page_header_description { font-size: 1.9em; color: rgb(238, 238, 238); font-weight: 500; line-height: 1em; }

@media (min-width: 660px) {
  .page_header_description { font-size: 2em; }
}

@media (min-width: 710px) {
  .page_header_description { font-size: 2.1em; }
}

@media (min-width: 850px) {
  .page_header_description { font-size: 2.2em; }
}

.page_header_secondary_text { color: rgb(134, 186, 222); font-weight: 300; font-size: 1.05em; padding-top: 0.5em; }

@media (min-width: 660px) {
  .page_header_secondary_text { font-size: 1em; padding-top: 0.6em; line-height: 1.35em; }
}

@media (min-width: 850px) {
  .page_header_secondary_text { font-size: 1.1em; padding-top: 0.75em; line-height: 1.5em; }
}

.page_header_background_image_item { background-image: url("/images/dealbreaker-senders-bane.jpg"); min-height: 220px; background-size: cover; background-position: center center; }

.btn-flat-light-blue { background: rgb(0, 132, 221); border-color: rgb(0, 132, 221); color: rgb(247, 247, 247); font-size: 14px; font-weight: 500; border-width: 1px; padding-top: 8px; padding-bottom: 8px; }

.btn-flat-light-blue:hover { background: rgb(38, 41, 45); border-color: rgb(38, 41, 45); color: rgb(247, 247, 247); }

.btn-flat-light-blue:active, .btn-flat-light-blue:focus { background: rgb(38, 41, 45); border-color: rgb(38, 41, 45); color: rgb(247, 247, 247); }

.btn-flat-light-green { background: rgb(0, 183, 73); color: rgb(247, 247, 247); font-size: 14px; font-weight: 500; border: 0px; }

.btn-flat-light-green:hover, .btn-flat-light-green:active, .btn-flat-light-green:focus { background: rgb(0, 0, 0); color: rgb(247, 247, 247); }

.feature_container { width: 20%; padding: 16px 0px 0px 16px; }

@media (max-width: 489px) {
  .feature_container { width: 100%; margin-right: 16px; }
}

@media (min-width: 490px) {
  .feature_container { width: calc(50% - 8px); }
}

@media (min-width: 768px) {
  .feature_container { width: calc(33.3333% - 5.33333px); }
}

@media (min-width: 992px) {
  .feature_container { width: calc(25% - 4px); }

.lb-stats { width: 100%; background: rgb(48, 53, 58); padding: 7px 9px 9px; box-sizing: border-box; border-top: 1px solid rgb(31, 34, 38); border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }

.lb-stats > div { display: flex; justify-content: space-between; align-items: center; margin: 2px 0px; }

.lb-stat-label { color: rgb(170, 170, 170); font-size: 0.78rem; }

.lb-stat-val { color: rgb(56, 211, 90); font-weight: 700; font-size: 0.8rem; }

.lb-rank { color: rgb(255, 255, 255); font-size: 0.8rem; font-weight: 800; }

.lb-pagination { display: flex; justify-content: center; gap: 7px; flex-wrap: wrap; margin: 16px 0px 20px; }

.lb-page-btn { background: rgb(22, 25, 29); border: 1px solid rgb(42, 46, 52); color: rgb(213, 213, 213); min-width: 34px; height: 32px; padding: 0px 9px; border-radius: 4px; cursor: pointer; }

.lb-page-btn.active { background: rgb(22, 151, 232); border-color: rgb(22, 151, 232); color: rgb(255, 255, 255); }

@media (max-width: 768px) {
  .leaderboard-main { padding: 16px 12px 70px; }
  .lb-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .lb-avatar { height: 145px; padding: 10px; }
}

.lb-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; margin-bottom: 22px; }

.lb-card { background: rgb(48, 53, 58); border: 1px solid rgb(31, 34, 38); border-radius: 3px; text-decoration: none; color: inherit; box-shadow: rgba(0, 0, 0, 0.35) 0px 3px 8px; }

.lb-card:hover { transform: translateY(-2px); }

.lb-name { display: flex; align-items: center; background: rgb(37, 42, 47); color: rgb(232, 232, 232); font-size: 0.9rem; font-weight: 700; padding: 6px 8px; margin: 0px; border-top-left-radius: 2px; border-top-right-radius: 2px; }


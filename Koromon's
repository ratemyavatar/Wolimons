  .game-btn-link { margin-top: 12px; }
}

@media (min-width: 850px) {
  .game-btn-link { margin-top: 14px; }
}

.h2_std { color: rgb(238, 238, 238); font-size: 1.6rem; }

@media (min-width: 768px) {
  .h2_std { font-size: 1.75rem; }
}

.catalog-link-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1em; }

@media (min-width: 480px) {
  .catalog-link-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1020px) {
  .catalog-link-grid { grid-template-columns: repeat(6, 1fr); }

# Batch files must keep CRLF line endings. cmd.exe can mis-parse a .bat
# saved with bare LF - labels and block structure are the usual casualties.
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts go on Windows too, so keep them CRLF for consistency.
*.ps1 text eol=crlf

# Shell scripts must keep LF, even if someone edits them on Windows.
*.sh text eol=lf

# The saved page snapshots are MHTML: mixed text and base64-encoded binary
# with CRLF line endings baked in. Git must not touch their line endings, or
# every checkout rewrites them and the embedded images break. They have no
# file extension, so they are listed by name.
"snapshots/Original - Account Verification" -text
"snapshots/Original - Badges" -text
"snapshots/Original - Domino Crown" -text
"snapshots/Original - Dominus Empyreus" -text
"snapshots/Original - Homepage" -text
"snapshots/Original - Item Catalog" -text
"snapshots/Original - Leaderboard" -text
"snapshots/Original - Player Profile" -text
"snapshots/Original - Player Profile 2" -text
"snapshots/Original - Richest Players" -text
"snapshots/Original - Site Preferences" -text
"snapshots/Original - Trade Ad Detail" -text
"snapshots/Original - Trade Ads" -text
"snapshots/Original - Trade Calculator" -text
"snapshots/Original - Trade Calculator 2" -text
*.mhtml -text


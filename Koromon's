@media (min-width: 710px) {
  .page_header_description { font-size: 2.1em; }
}

@media (min-width: 850px) {
  .page_header_description { font-size: 2.2em; }
}

.page_header_secondary_text { color: rgb(134, 186, 222); font-weight: 300; font-size: 1.05em; padding-top: 0.5em; }


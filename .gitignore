# Dependencies (the site itself has no build step; this is for proxy/ and tools/)
node_modules/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Local overrides and secrets — the proxy reads ADMIN_KEY / GITHUB_TOKEN from env
.env
.env.*
!.env.example

# Live data written by the server when STORAGE=file.
# The committed data/wolimons-data.json is the starting point and stays
# tracked; this is the running copy, which changes every time a value is
# saved and must not turn into a dirty working tree or a merge conflict.
proxy/data/
*.json.bak
*.json.tmp

# Logs
*.log
npm-debug.log*
logs/

# Downloaded by windows/setup.bat on first use, not ours to ship.
windows/nssm.exe
windows/cloudflared.exe

@charset "utf-8";

#page_content_container { display: flex; justify-content: center; align-items: flex-start; max-width: 1822px; margin: 0px auto; width: 100%; }

#page_content_body { width: 100%; max-width: 1138px; }

#left_gutter, #right_gutter { position: sticky; top: 24px; margin-top: 24px; z-index: 1000; display: none; }

@media (min-width: 1475px) {
  #left_gutter, #right_gutter { width: 160px; display: block; }
}

@media (min-width: 1755px) {
  #left_gutter, #right_gutter { width: 300px; }
}

@media (max-width: 768px) {
  .navbar-nav .dropdown-menu { position: absolute; }
  .navbar-nav .nav-link { padding-left: 12px; padding-right: 12px; }
}

@media (min-width: 768px) {
  .main-navbar-ul { flex: 1 1 0%; display: flex; justify-content: space-evenly; margin: auto !important; }
}

.navbar_menu_item_outer { text-align: center; min-width: 63px; max-width: 63px; }

@media (min-width: 768px) {
  .navbar_menu_item_outer { min-width: 64px; }
}

@media (min-width: 860px) {
  .navbar_menu_item_outer { min-width: 72px; }
}

.navbar_dropdown_static { position: static; }

@media (min-width: 768px) {
  .navbar_dropdown_static { position: relative; }
}

.navbar_menu_item_inner { padding-top: 6px; padding-bottom: 6px; cursor: pointer; }

@media (min-width: 768px) {
  .navbar_menu_item_inner { padding-top: 7px; padding-bottom: 7px; }
}

.navbar_menu_item_title { white-space: nowrap; font-size: 10px; color: rgb(170, 170, 170); }

@media (min-width: 768px) {
  .navbar_menu_item_title { font-size: 12px; margin: auto 0px; }
}

.site_navbar_menu_icon_svg { color: rgb(255, 255, 255); margin: 0px auto; width: 1.85em; height: 1.85em; }

@media (min-width: 768px) {
  .site_navbar_menu_icon_svg { width: 2.25em; height: 2.25em; }
}

.navbar_item_title { font-size: 12px; color: rgb(170, 170, 170); margin: auto 0px auto 8px; }

.dropdown-toggle::after { display: none; }

.site_navbar_item { display: flex; white-space: nowrap; padding-top: 5px; padding-bottom: 5px; }

@media (min-width: 768px) {
  .site_navbar_item { padding-top: 7px; padding-bottom: 7px; }
}

.site_navbar_icon_svg { color: rgb(255, 255, 255); width: 1.85em; height: 1.85em; }

@media (min-width: 768px) {
  .main-navbar-ul > .dropdown:hover > .dropdown-menu { display: block; }
  .main-navbar-ul > .dropdown > .dropdown-toggle:active { pointer-events: none; }
}

#navbarSupportedContent .dropdown-menu { padding: 0px; border-radius: 0px; border: 0px; margin-top: 0px; }

#navbarSupportedContent > div > div > div.dropdown-menu { z-index: 2000; }

.sitefooter-info-section-grid { display: grid; gap: 0.5rem 2.5rem; margin-left: 3rem; margin-right: 3rem; padding-top: 24px; }

@media (min-width: 540px) {
  .sitefooter-info-section-grid { grid-template-columns: 2.5fr 0.75fr 0.75fr; }
}

.sitefooter-about-title { color: rgb(0, 132, 221); font-weight: 700; font-size: 1.8em; height: 40px; }

.sitefooter-links-title { color: rgb(106, 148, 181); font-weight: 600; font-size: 1.25em; line-height: 2.5em; height: 40px; }

.sitefooter-links-link { color: rgb(221, 221, 221); display: block; font-weight: 600; font-size: 0.95em; white-space: nowrap; line-height: 2em; height: 34px; }

.sitefooter-links-link:hover { color: rgb(255, 255, 255); text-decoration: none; }

.limited_ribbon { position: absolute; bottom: 4px; left: 4px; height: 15px; width: auto; }

.gen_items_slider_main_image_container .system_item_tag_container { left: auto; right: 4px; }

.owned_item_tag_container { position: absolute; display: flex; top: 4px; right: 4px; z-index: 1; }

.owned_item_tag_icon { width: 20px; height: 20px; margin-left: 3px; filter: drop-shadow(rgba(0, 0, 0, 0.5) 0px 1px 1px); }

.owned_item_tag_icon svg { display: block; width: 100%; height: 100%; }

.system_item_tag_container { position: absolute; display: flex; bottom: 4px; left: 4px; }

.system_item_tag_icon { margin-left: 3px; width: 18px; height: 18px; background-size: contain; background-repeat: no-repeat; }

.page-tradecalc .system_item_tag_icon { width: 16px; height: 16px; }


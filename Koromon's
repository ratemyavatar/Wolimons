#page_background { background-image: linear-gradient(rgba(0, 0, 0, 0) 0%, rgb(39, 43, 48)), url("img/koromons-banner-blurred.webp"); opacity: 0.75; background-size: cover; background-position: 50% 10%; pointer-events: none; top: 0px; left: 0px; right: 0px; width: 100%; height: 750px; position: fixed; z-index: -1; }

